# Docker's own Fedora repository. raigolmid drives `docker compose` as a subprocess, and
# docker-compose-plugin is the package Docker documents as providing that verb.
[docker-ce-stable]
name=Docker CE Stable - $basearch
baseurl=https://download.docker.com/linux/fedora/$releasever/$basearch/stable
enabled=1
gpgcheck=1
gpgkey=https://download.docker.com/linux/fedora/gpg
