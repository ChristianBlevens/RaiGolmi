# The launcher and its disk, built on Windows by the root build.bat or downloaded by
# setup.bat (with the partial download and the launcher waiting to replace a running one)
/windows/RaiGolmi.exe
/windows/RaiGolmi.exe.*
/windows/RaiGolmi.pdb
/windows/bin/
/windows/obj/
/windows/qemu.log
/windows/qemu.previous.log
/windows/screen.ppm
/windows/screen.ppm.partial
# Machine-local: the public keys the launcher lets in beside its own
/windows/authorized_keys

# The working documents and the VM toolkit: kept on disk, never in the repository.
/ARCHITECTURE.md
/SESSION-START.md
/docs/
/spikes/
/disk/
/RaiGolmi.lnk
/transfer/
