+typedef struct RawWin32DiscardData {
+    HANDLE hfile;
+    int64_t offset;
+    int64_t bytes;
+} RawWin32DiscardData;
+
+static int discard_worker(void *arg)
+{
+    RawWin32DiscardData *d = arg;
+    FILE_ZERO_DATA_INFORMATION zero;
+    DWORD returned;
+
+    zero.FileOffset.QuadPart = d->offset;
+    zero.BeyondFinalZero.QuadPart = d->offset + d->bytes;
+    if (!DeviceIoControl(d->hfile, FSCTL_SET_ZERO_DATA, &zero, sizeof(zero),
+                         NULL, 0, &returned, NULL)) {
+        return -EIO;
+    }
+    return 0;
+}
+
+/*
+ * A discarded range is released from the file in place: NTFS deallocates what
+ * FSCTL_SET_ZERO_DATA zeroes in a sparse file, so the file's size on disk
+ * shrinks with what the guest frees. Without sparse it would write zeros.
+ */
+static int coroutine_fn GRAPH_RDLOCK
+raw_co_pdiscard(BlockDriverState *bs, int64_t offset, int64_t bytes)
+{
+    BDRVRawState *s = bs->opaque;
+    RawWin32DiscardData d = { .hfile = s->hfile, .offset = offset,
+                              .bytes = bytes };
+
+    if (!s->sparse) {
+        return -ENOTSUP;
+    }
+    return thread_pool_submit_co(discard_worker, &d);
+}
+
 static int set_sparse(int fd)
 {
     DWORD returned;
